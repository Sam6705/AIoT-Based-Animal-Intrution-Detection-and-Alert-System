function FINAL_CODESJSON
    %--------------------------------------------------------------
    % Create main figure
    %--------------------------------------------------------------
    hFig = figure('Name', 'CAM1', ...
                  'NumberTitle', 'off', 'MenuBar', 'none', 'ToolBar', 'none', ...
                  'Color', [0.95 0.95 0.95], 'Position', [100 50 1250 700], ...
                  'CloseRequestFcn', @closeGUI);

    % Title
    uicontrol('Style', 'text', 'Parent', hFig, 'String', 'CAM1', ...
              'FontSize', 20, 'FontWeight', 'bold', 'FontName', 'Times New Roman', ...
              'ForegroundColor', [0.1 0.1 0.5], 'BackgroundColor', [0.95 0.95 0.95], ...
              'Position', [350 650 550 40]);

    % Main video display
    hAx = axes('Parent', hFig, 'Units', 'pixels', 'Position', [80 150 500 450]);
    axis(hAx, 'off');

    % Detection info (updated to meters)
    hText = uicontrol('Style', 'text', 'Position', [80 90 600 40], 'FontSize', 13, ...
                      'FontName', 'Times New Roman', 'ForegroundColor', 'k', ...
                      'BackgroundColor', [0.95 0.95 0.95], ...
                      'String', 'Detected Object: - | Distance: - m | Risk: -');

    % Warning text
    hWarn = uicontrol('Style', 'text', 'Position', [80 50 600 30], 'FontSize', 13, ...
                      'FontName', 'Times New Roman', 'FontWeight', 'bold', ...
                      'BackgroundColor', [0.95 0.95 0.95], 'ForegroundColor', 'red', ...
                      'String', '', 'Visible', 'off');

    %--------------------------------------------------------------
    % Graph axes (2 graphs) - Updated to meters
    %--------------------------------------------------------------
    ax1 = subplot('Position', [0.62 0.55 0.32 0.18]); % Distance
    ax2 = subplot('Position', [0.62 0.25 0.32 0.18]); % Risk Factor

    titles = {'Distance vs Time (m)', 'Risk Factor vs Time (%)'};
    axs = [ax1, ax2];
    
    for i = 1:2
        title(axs(i), titles{i}, 'FontSize', 12, 'FontWeight', 'bold');
        xlabel(axs(i), 'Frame Number');
        ylabel(axs(i), 'Value');
        grid(axs(i), 'on');
        hold(axs(i), 'on');
        
        % Initialize with empty plots
        if i == 1
            hPlot1 = plot(axs(i), NaN, NaN, 'r-', 'LineWidth', 1.5);
        else
            hPlot2 = plot(axs(i), NaN, NaN, 'b-', 'LineWidth', 1.5);
        end
    end

    % Initialize data buffers
    distData = [];  % Now in meters
    riskData = [];
    tBuffer = [];
    frameIdx = 0;
    maxPoints = 100; % Keep last 100 points for display
    
    % -------------------------------------------------------------
    % Performance Metrics Counters
    % -------------------------------------------------------------
    TP = 0;  % True Positive (animal detected correctly)
    FP = 0;  % False Positive (non-animal detected as animal)
    FN = 0;  % False Negative (animal present but not detected)
    TN = 0;  % True Negative (no animal and correctly detected none)

    %--------------------------------------------------------------
    % Firebase Configuration - YOUR SPECIFIC DATABASE
    %--------------------------------------------------------------
    firebaseConfig = struct();
    firebaseConfig.databaseURL = 'https://animal-1e87b-default-rtdb.firebaseio.com/';
    firebaseConfig.projectId = 'animal-1e87b';
    
    % Note: For public database without authentication, we can write directly
    % If you need authentication, you'll need to add API keys and auth tokens
    
    % Initialize Firebase
    [firebaseStatus, firebaseApp] = initializeFirebase(firebaseConfig);
    
    if firebaseStatus
        disp('✅ Firebase initialized successfully');
        disp(['📊 Database URL: ' firebaseConfig.databaseURL]);
    else
        disp('⚠️ Warning: Firebase initialization failed. Data will only be logged locally.');
    end
    
    % Tracking last sent data to avoid duplicates
    lastSentData = struct();
    lastFirebaseTime = tic;
    firebaseCooldown = 1; % Minimum seconds between Firebase updates (reduced to 1 second)
    
    %--------------------------------------------------------------
    % Load YOLOv2
    %--------------------------------------------------------------
    modelName = 'tinyYOLOv2-coco';
    
    % Check if model exists, download if needed
    if ~exist([modelName '.mat'], 'file')
        disp('📥 Downloading pretrained YOLOv2 model...');
        try
            helper.downloadPretrainedYOLOv2(modelName);
        catch
            % Alternative if helper function doesn't exist
            disp('⚠️ Please download the YOLOv2 model manually or check your connection');
            disp('Continuing with assumed model file...');
        end
    end
    
    try
        pretrained = load(modelName);
        detector = pretrained.yolov2Detector;
    catch
        error('Failed to load YOLOv2 detector. Please ensure the model file exists.');
    end

    % Initialize camera
    try
        cam = webcam(1);
    catch
        try
            % Try default camera if camera 1 fails
            cam = webcam;
        catch
            error('No webcam detected. Please connect a camera and try again.');
        end
    end
    
    focalLength = 800; 
    knownWidth = 0.2; % Changed to meters (20 cm = 0.2 m)

    disp('🔹 Live detection with Firebase integration running...');
    disp('🔸 Close the figure window to stop');
    
    %--------------------------------------------------------------
    % Create stop button
    %--------------------------------------------------------------
    uicontrol('Style', 'pushbutton', 'String', 'STOP', ...
              'Position', [600 50 100 30], ...
              'FontSize', 12, 'FontWeight', 'bold', ...
              'BackgroundColor', [1 0.5 0.5], ...
              'Callback', @(~,~) closeGUI(hFig, cam));
    
    %--------------------------------------------------------------
    % Initialize sound variables
    %--------------------------------------------------------------
    % Generate random frequencies for sound (200 Hz to 2000 Hz)
    randomFrequencies = randi([200, 2000], 1, 10);
    currentFreqIndex = 1;
    
    % Audio parameters
    sampleRate = 8192;
    duration = 0.3; % seconds
    t = 0:1/sampleRate:duration;
    
    % Generate random sounds
    soundSignals = {};
    for i = 1:length(randomFrequencies)
        % Create a beep sound with random frequency
        soundSignals{i} = sin(2 * pi * randomFrequencies(i) * t');
        % Apply envelope to avoid clicks
        envelope = linspace(0, 1, length(t)/4)';
        envelope = [envelope; ones(length(t)/2, 1); flip(envelope)];
        if length(envelope) > length(soundSignals{i})
            envelope = envelope(1:length(soundSignals{i}));
        elseif length(envelope) < length(soundSignals{i})
            envelope = [envelope; ones(length(soundSignals{i}) - length(envelope), 1)];
        end
        soundSignals{i} = soundSignals{i} .* envelope;
    end
    
    lastSoundTime = tic;
    soundCooldown = 2; % Minimum seconds between sounds
    soundEnabled = true;
    
    %--------------------------------------------------------------
    % Arduino Serial Communication Setup (Optional)
    %--------------------------------------------------------------
    arduinoPort = 'COM5';
    arduinoBaudRate = 9600;
    
    % Try to connect to Arduino
    try
        arduinoSerial = serialport(arduinoPort, arduinoBaudRate);
        configureTerminator(arduinoSerial, "LF");
        disp(['✅ Connected to Arduino on ' arduinoPort]);
        arduinoConnected = true;
        
        % Clear any pending data
        while arduinoSerial.NumBytesAvailable > 0
            readline(arduinoSerial);
        end
    catch
        disp(['⚠️ Warning: Could not connect to Arduino on ' arduinoPort]);
        disp('   Continuing without Arduino communication');
        arduinoConnected = false;
        arduinoSerial = [];
    end
    
    % Animal type mapping
    % Animal categories from COCO dataset
    animalCategories = {
        'bird', 'cat', 'dog', 'horse', 'sheep', 'cow', 'elephant', ...
        'bear', 'zebra', 'giraffe', 'bird', 'cat', 'dog', 'horse', ...
        'sheep', 'cow', 'elephant', 'bear', 'zebra', 'giraffe'
    };
    
    % Track last sent animal code to avoid spamming
    lastSentCode = '';
    lastArduinoTime = tic;
    arduinoCooldown = 3; % Seconds between Arduino commands
    
    %--------------------------------------------------------------
    % Function to send code to Arduino
    %--------------------------------------------------------------
    function sendToArduino(code)
        if ~arduinoConnected
            return;
        end
        
        % Check cooldown period
        if toc(lastArduinoTime) < arduinoCooldown
            return;
        end
        
        try
            writeline(arduinoSerial, code);
            disp(['📤 Sent to Arduino: ' code]);
            lastArduinoTime = tic;
            lastSentCode = code;
        catch
            disp('⚠️ Failed to send to Arduino');
        end
    end

    %--------------------------------------------------------------
    % Function to determine animal code based on animal type
    %--------------------------------------------------------------
    function code = getAnimalCode(animalType)
        % Convert to lowercase for comparison
        animalLower = lower(char(animalType));
        
        % Determine code based on animal type and risk level
        if contains(animalLower, 'dog') || contains(animalLower, 'cat')
            code = 'AA'; % Small domestic animals
        elseif contains(animalLower, 'sheep') || contains(animalLower, 'cow') || ...
               contains(animalLower, 'horse') || contains(animalLower, 'zebra')
            code = 'BB'; % Large domestic/herd animals
        elseif contains(animalLower, 'elephant') || contains(animalLower, 'bear') || ...
               contains(animalLower, 'giraffe')
            code = 'CC'; % Large wild animals
        elseif contains(animalLower, 'bird')
            code = 'AA'; % Small animals (birds)
        else
            code = 'AA'; % Default for other animals
        end
    end
    
    %--------------------------------------------------------------
    % Firebase Functions
    %--------------------------------------------------------------
    function [status, app] = initializeFirebase(config)
        % Initialize Firebase connection
        status = false;
        app = [];
        
        try
            % Test the Firebase connection
            testURL = [config.databaseURL '.json?shallow=true'];
            options = weboptions('Timeout', 5, 'RequestMethod', 'get');
            
            % Try to connect to Firebase
            response = webread(testURL, options);
            
            % If we get here, connection is successful
            status = true;
            app = config;
            disp('✅ Successfully connected to Firebase Realtime Database');
            
        catch e
            disp(['⚠️ Firebase connection test failed: ' e.message]);
            disp('   Will continue with local logging only');
            status = false;
        end
    end

    function sendToFirebase(data)
        % Send detection data to Firebase Realtime Database
        
        if ~firebaseStatus
            % Log locally if Firebase not available
            logLocalData(data);
            return;
        end
        
        % Check cooldown period
        if toc(lastFirebaseTime) < firebaseCooldown
            return;
        end
        
        try
            % Prepare data for Firebase
            timestamp = datestr(now, 'yyyy-mm-dd HH:MM:SS.FFF');
            data.timestamp = timestamp;
            
            % Generate a unique key using timestamp and random number
            uniqueID = ['detection_' datestr(now, 'yyyymmdd_HHMMSS') '_' num2str(randi(9999), '%04d')];
            data.id = uniqueID;
            
            % For Realtime Database - using REST API
            % Create path with date for better organization
            datePath = datestr(now, 'yyyy-mm-dd');
            dbPath = ['/detections/' datePath '/' uniqueID];
            dbURL = [firebaseConfig.databaseURL dbPath '.json'];
            
            % Send to Realtime Database using PUT (creates new entry)
            options = weboptions('RequestMethod', 'put', ...
                               'MediaType', 'application/json', ...
                               'Timeout', 3); % Reduced timeout for faster response
            
            % Convert data to JSON and send
            jsonData = jsonencode(data);
            response = webwrite(dbURL, jsonData, options);
            
            % Also update a latest detection reference for easy access
            latestURL = [firebaseConfig.databaseURL '/detections/latest.json'];
            webwrite(latestURL, data, options);
            
            % Update risk summary if high risk
            if data.riskFactor > 70
                highRiskURL = [firebaseConfig.databaseURL '/high_risk/' uniqueID '.json'];
                webwrite(highRiskURL, data, options);
            end
            
            disp(['📤 Sent to Firebase: ' data.objectType ' at ' num2str(data.distance) 'm']);
            lastFirebaseTime = tic;
            
            % Also log locally as backup
            logLocalData(data);
            
        catch e
            disp(['⚠️ Firebase send failed: ' e.message]);
            % Log locally as backup
            logLocalData(data);
        end
    end

    function logLocalData(data)
        % Log data to local file as backup
        persistent logFile
        
        if isempty(logFile)
            % Create log file with date
            logFileName = ['detection_log_' datestr(now, 'yyyy-mm-dd') '.txt'];
            logFile = fopen(logFileName, 'a');
            if logFile == -1
                % Try different location if can't open in current directory
                logFileName = fullfile(tempdir, ['detection_log_' datestr(now, 'yyyy-mm-dd') '.txt']);
                logFile = fopen(logFileName, 'a');
                if logFile == -1
                    disp('⚠️ Could not open log file for writing');
                    return;
                end
            end
        end
        
        try
            % Write data to log file
            logEntry = sprintf('[%s] %s | Distance: %.2f m | Risk: %.1f%% | Conf: %.2f | Animal: %d\n', ...
                              data.timestamp, data.objectType, data.distance, ...
                              data.riskFactor, data.confidence, data.isAnimal);
            fprintf(logFile, '%s', logEntry);
            fflush(logFile);
        catch e
            disp(['⚠️ Local logging failed: ' e.message]);
        end
    end

    %--------------------------------------------------------------
    % Detection Loop
    %--------------------------------------------------------------
    isRunning = true;
    
    while ishandle(hFig) && isRunning
        frameIdx = frameIdx + 1;
        
        try
            img = snapshot(cam);
        catch
            disp('❌ Camera error!');
            break;
        end
        
        [boxes, scores, labels] = detect(detector, img);

        if ~isempty(boxes)
            % Find highest confidence detection
            [maxScore, idx] = max(scores);
            box = boxes(idx, :);
            
            imgAnnotated = insertObjectAnnotation(img, 'rectangle', box, labels(idx));
            
            % Calculate distance in meters
            boxWidth = box(3);
            distance = (knownWidth * focalLength) / max(boxWidth, 1); % Distance in meters
            
            detectedObject = string(labels(idx));
            
            % Risk Factor calculation (0-100 scale)
            distance_cm = distance * 100;
            baseRisk = max(0, 100 - distance_cm); % Higher risk for closer objects
            riskFactor = min(100, baseRisk * maxScore * 1.5);
            
            % Check if detected object is an animal
            isAnimal = false;
            animalType = '';
            
            % List of animal classes from COCO dataset
            animalClasses = {'bird', 'cat', 'dog', 'horse', 'sheep', 'cow', ...
                             'elephant', 'bear', 'zebra', 'giraffe'};
            
            currentLabel = lower(char(detectedObject));
            for a = 1:length(animalClasses)
                if contains(currentLabel, animalClasses{a})
                    isAnimal = true;
                    animalType = animalClasses{a};
                    break;
                end
            end
            
            % Prepare data for Firebase
            detectionData = struct();
            detectionData.objectType = char(detectedObject);
            detectionData.distance = distance;
            detectionData.riskFactor = riskFactor;
            detectionData.confidence = maxScore;
            detectionData.isAnimal = isAnimal;
            detectionData.frameNumber = frameIdx;
            detectionData.boundingBox = box;
            
            % Add device information
            [~, hostname] = system('hostname');
            detectionData.deviceName = strtrim(hostname);
            detectionData.matlabVersion = version();
            
            if isAnimal
                detectionData.animalType = animalType;
                detectionData.animalCode = getAnimalCode(animalType);
                detectionData.category = 'animal';
            else
                detectionData.category = 'object';
            end
        % -------------------------------------------------------------
        % Update metrics counters
        % -------------------------------------------------------------
if isAnimal
    TP = TP + 1;
else
    FP = FP + 1;
end
            % Send to Firebase (every 1 second or for every animal detection)
            if isAnimal || (toc(lastFirebaseTime) >= firebaseCooldown)
                sendToFirebase(detectionData);
            end
            
            % Send Arduino command if animal detected
            if isAnimal && arduinoConnected
                animalCode = getAnimalCode(animalType);
                
                % Don't send same code repeatedly within cooldown period
                if toc(lastArduinoTime) >= arduinoCooldown || ~strcmp(animalCode, lastSentCode)
                    sendToArduino(animalCode);
                    
                    % Also send specific code based on risk level for animals
                    if riskFactor > 70
                        sendToArduino([animalCode 'H']); % High risk
                    elseif riskFactor > 40
                        sendToArduino([animalCode 'M']); % Medium risk
                    end
                end
            end
            
            % Warning logic based on risk
            if riskFactor > 70
                warningMsg = sprintf('🚨 HIGH RISK! %s at %.2f m | Risk: %.1f%%', ...
                                      detectedObject, distance, riskFactor);
                set(hWarn, 'String', warningMsg, 'Visible', 'on', 'ForegroundColor', 'red');
                set(hText, 'ForegroundColor', 'r');
                
                % Play sound for high risk
                if soundEnabled && toc(lastSoundTime) > soundCooldown
                    randomIndex = randi(length(soundSignals));
                    sound(soundSignals{randomIndex}, sampleRate);
                    lastSoundTime = tic;
                end
                
            elseif riskFactor > 40
                warningMsg = sprintf('⚠️ Caution: %s at %.2f m | Risk: %.1f%%', ...
                                      detectedObject, distance, riskFactor);
                set(hWarn, 'String', warningMsg, 'Visible', 'on', 'ForegroundColor', [0.9 0.5 0]);
                set(hText, 'ForegroundColor', [0.9 0.5 0]);
                
            else
                set(hWarn, 'Visible', 'off');
                set(hText, 'ForegroundColor', 'k');
            end

            % Update detection info text
            if isAnimal
                hText.String = sprintf('🐾 ANIMAL: %s | Distance: %.2f m | Risk: %.1f%% | Conf: %.2f', ...
                                        detectedObject, distance, riskFactor, maxScore);
            else
                hText.String = sprintf('Detected: %s | Distance: %.2f m | Risk: %.1f%% | Conf: %.2f', ...
                                        detectedObject, distance, riskFactor, maxScore);
            end

            % Update buffers
            distData(end+1) = distance;
            riskData(end+1) = riskFactor;
            tBuffer(end+1) = frameIdx;
            
            % Limit buffer size
            if length(tBuffer) > maxPoints
                tBuffer = tBuffer(end-maxPoints+1:end);
                distData = distData(end-maxPoints+1:end);
                riskData = riskData(end-maxPoints+1:end);
            end
        else
            imgAnnotated = img;
            hText.String = 'Detected: - | Distance: - m | Risk: - | Conf: -';
            set(hWarn, 'Visible', 'off');
            set(hText, 'ForegroundColor', 'k');
        end

        % Update video feed
        imshow(imgAnnotated, 'Parent', hAx);
        title(hAx, sprintf('CAM1 - Frame %d', frameIdx), 'FontSize', 14);

        % Update graphs
        if ~isempty(distData) && ~isempty(tBuffer)
            cla(ax1);
            cla(ax2);
            
            plot(ax1, tBuffer, distData, 'r-', 'LineWidth', 1.5);
            title(ax1, titles{1}, 'FontSize', 12, 'FontWeight', 'bold');
            xlabel(ax1, 'Frame Number');
            ylabel(ax1, 'Distance (m)');
            grid(ax1, 'on');
            
            plot(ax2, tBuffer, riskData, 'b-', 'LineWidth', 1.5);
            title(ax2, titles{2}, 'FontSize', 12, 'FontWeight', 'bold');
            xlabel(ax2, 'Frame Number');
            ylabel(ax2, 'Risk (%)');
            grid(ax2, 'on');
            
            if length(tBuffer) >= 2
                xlim(ax1, [min(tBuffer), max(tBuffer)]);
                xlim(ax2, [min(tBuffer), max(tBuffer)]);
            end
            
            if ~isempty(distData) && max(distData) > 0
                ylim(ax1, [0, min(5, max(distData)*1.1)]);
            else
                ylim(ax1, [0, 2]);
            end
            ylim(ax2, [0, 100]);
        end
        
        drawnow limitrate;
    end

    %--------------------------------------------------------------
    % Cleanup function
    %--------------------------------------------------------------
    function closeGUI(~, ~)
        isRunning = false;
        
        % Send offline status to Firebase
        if firebaseStatus
            try
                offlineData = struct();
                offlineData.status = 'offline';
                offlineData.timestamp = datestr(now, 'yyyy-mm-dd HH:MM:SS.FFF');
                [~, hostname] = system('hostname');
                offlineData.deviceName = strtrim(hostname);
                
                statusURL = [firebaseConfig.databaseURL '/status.json'];
                options = weboptions('RequestMethod', 'put', 'Timeout', 2);
                webwrite(statusURL, offlineData, options);
            catch
                % Ignore errors during cleanup
            end
        end
        
        % Close Arduino connection
        if arduinoConnected
            try
                clear arduinoSerial;
                disp('🔌 Arduino connection closed');
            catch
                % Ignore errors during cleanup
            end
        end
        
        % Close local log file
        try
            fclose('all');
        catch
            % Ignore errors
        end
        
        if exist('cam', 'var')
            clear cam;
        end
        clear sound;
        delete(hFig);
        
        disp('👋 Application stopped');
    end
end